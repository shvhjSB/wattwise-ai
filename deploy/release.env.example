WATTWISE_API_IMAGE=registry.example/wattwise-api@sha256:REPLACE_WITH_VERIFIED_DIGEST
WATTWISE_FRONTEND_IMAGE=registry.example/wattwise-frontend@sha256:REPLACE_WITH_VERIFIED_DIGEST
WATTWISE_DB_PASSWORD_FILE=/etc/wattwise/secrets/db_password
WATTWISE_DB_ADMIN_PASSWORD_FILE=/etc/wattwise/secrets/db_admin_password
WATTWISE_DATABASE_URL_FILE=/etc/wattwise/secrets/database_url
WATTWISE_POSTGRES_VOLUME=wattwise-postgres
WATTWISE_ARTIFACT_VOLUME=wattwise-artifacts-RELEASE
WATTWISE_MODEL_VERSION=REPLACE_WITH_VERIFIED_MODEL_VERSION
WATTWISE_MODEL_DATA_KIND=observed
WATTWISE_PORT=8080
WATTWISE_API_MEMORY=2g
WATTWISE_DB_MEMORY=1g
