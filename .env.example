# WattWise AI — example configuration.
# Copy the values you need into your shell, a local .env file, or your deployment platform.
# Never commit real secrets: .env and .env.* files (except this one) are git-ignored.

# Deployment environment: development | test | production
WATTWISE_ENVIRONMENT=development
# Private deployment alternative to an environment database URL: mount a secret file named
# WATTWISE_DATABASE_URL here. Do not configure both sources. Missing secrets fail at startup.
# WATTWISE_SECRETS_DIR=/run/secrets
# Cross-origin browser access is disabled unless explicitly allowed (JSON array, no wildcard).
# Same-origin Nginx/Vite proxy usage needs no CORS configuration.
# WATTWISE_CORS_ORIGINS=["https://dashboard.example"]
# Whole HTTP body ceiling, including multipart overhead; CSV files also have a per-file limit.
# WATTWISE_MAX_REQUEST_BYTES=32000000
# WATTWISE_MAX_UPLOAD_BYTES=10000000
# HTTP deadline; timed-out work may finish in the background and still occupies capacity.
# WATTWISE_REQUEST_TIMEOUT_SECONDS=60
# Per-worker limit; saturation returns 503. This is not an authentication/rate-limit service.
# WATTWISE_MAX_CONCURRENT_REQUESTS=16
# Docker demo frontend host port; the API and demo PostgreSQL stay internal.
# WATTWISE_DEMO_PORT=8080

# Recorded test reports used by the Model lab (paths relative to backend/).
# Must contain chosen.json and seasonal-naive-1w.json matching the served model.
# WATTWISE_EVALUATION_ROOT=../data/processed/evaluation/fullscale/test
# Use synthetic for models trained on generated data; the default observed label describes BDG2.
# WATTWISE_MODEL_DATA_KIND=observed

# PostgreSQL for the API (T023): postgresql+psycopg://user:password@host:port/database
# Unset means no database: /api/v1/health works, /api/v1/ready answers 503.
# Put the real value in the untracked backend/.env, never here.
# WATTWISE_DATABASE_URL=postgresql+psycopg://wattwise:CHANGE-ME@localhost:5432/wattwise

# A database the tests may create and drop schemas in (tests only).
# WATTWISE_TEST_DATABASE_URL=postgresql+psycopg://wattwise:CHANGE-ME@localhost:5432/wattwise_test
