# WattWise AI frontend configuration (Vite).
# Copy to frontend/.env.local for local overrides. Files named .env or .env.* (except this one)
# are git-ignored. Variables prefixed with VITE_ are embedded in the public browser bundle, so
# never put secrets in them.

# Base URL of the WattWise API. Leave empty to call the API on the same origin: the dev server
# proxies /api to WATTWISE_DEV_API_TARGET, and production uses a reverse proxy.
VITE_API_BASE_URL=

# Dev server only: where `npm run dev` proxies /api requests. Not embedded in the bundle.
WATTWISE_DEV_API_TARGET=http://127.0.0.1:8000
